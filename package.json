  "private": true,
  "scripts": {
    "dev": "BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA=true BROWSERSLIST_IGNORE_OLD_DATA=true next dev --turbopack",
    "build": "BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA=true BROWSERSLIST_IGNORE_OLD_DATA=true prisma generate && BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA=true BROWSERSLIST_IGNORE_OLD_DATA=true next build",
    "start": "BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA=true BROWSERSLIST_IGNORE_OLD_DATA=true next start",
    "lint": "BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA=true BROWSERSLIST_IGNORE_OLD_DATA=true eslint",
    "test": "bun test",
    "db:push": "prisma db push",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:criar-base": "tsx scripts/criar-base-comercial.ts",
    "prisma:generate": "prisma generate",
    "worker:emissao": "tsx scripts/worker-emissao.ts",
    "worker:webhook": "tsx scripts/worker-webhook.ts",
    "db:faturar": "tsx scripts/fechamento-faturamento.ts",
    "simular:loop": "tsx scripts/simulador-emissao-continua.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "bcryptjs": "^3.0.3",
    "jspdf": "^4.2.1",
    "next": "^16.2.6",
    "next-auth": "^4.24.14",
    "node-forge": "^1.4.0",
    "prisma": "^6.14.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "xml2js": "^0.6.2",
    "xmlbuilder2": "^4.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@types/bcryptjs": "^3.0.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.1",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/xml2js": "^0.4.14",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.2.6",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
